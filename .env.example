RAG_DB_PATH=data/rag.db
RAG_SOURCE_DIR=data/source
RAG_TOP_K=5
MIN_EVIDENCE_SCORE=0.005

# 阿里云百炼：中国（北京）地域
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding：默认 hash 仅用于教学。生产环境改为 openai_compatible。
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_RETRIES=3

# 可选：接入 OpenAI 兼容的 Chat Completions 服务后启用生成式回答。
# 未配置时，系统使用本地“证据摘录式回答”，仍可完整演示检索与引用链路。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# 视觉理解：只处理疑难图片与规划图件
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3-vl-flash

# 可选：Reranker 默认关闭。rule 用于离线演示，生产可替换为 Qwen3-Reranker / BGE-Reranker 服务。
RERANKER_PROVIDER=none
RERANKER_TOP_N=50

# 自部署服务
MINERU_API_URL=http://127.0.0.1:8001
RERANKER_API_URL=http://127.0.0.1:8002/rerank
PADDLEOCR_API_URL=http://127.0.0.1:8003
QDRANT_URL=http://127.0.0.1:6333
